<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.oop.game.client.controllers.InvitePopupController"
      alignment="CENTER" spacing="15" prefWidth="350" prefHeight="150"
      style="-fx-background-color: #f4f4f4; -fx-padding:20; -fx-border-color:#ccc; -fx-border-width: 1; -fx-border-radius:10; -fx-background-radius:10;">

    <Label fx:id="inviteMessageLabel" text="Người chơi X mời bạn đấu!"
           style="-fx-font-size:16px; -fx-font-weight: bold;"/>

    <HBox spacing="20" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
        <Button text="✅ Chấp nhận" onAction="#onAcceptClicked"
                style="-fx-background-color:#4CAF50; -fx-text-fill:white; -fx-font-weight: bold; -fx-pref-width: 120;"/>

        <Button text="❌ Từ chối" onAction="#onDeclineClicked"
                style="-fx-background-color:#f44336; -fx-text-fill:white; -fx-font-weight: bold; -fx-pref-width: 120;"/>
    </HBox>
</VBox>